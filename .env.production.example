# ---------- Database ----------
# MySQL / MariaDB connection string used by Prisma (runtime + migrate deploy).
# connectionLimit is a count; acquireTimeout is milliseconds.
DATABASE_URL=mysql://cls_app:CHANGE_ME@127.0.0.1:3306/cls_facility?connectionLimit=5&acquireTimeout=30000

# ---------- Auth (better-auth) ----------
# Secret used to sign auth tokens. Generate a strong random value:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32

# Canonical HTTPS URL of the app (must exactly equal what browsers use)
BETTER_AUTH_URL=https://cls.example.org

# Persistent private runtime files; do not place this under public/ or a release directory.
PRIVATE_STORAGE_ROOT=/srv/cls-data
