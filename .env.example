# ---------- Database ----------
# MySQL / MariaDB connection string used by Prisma.
# Replace with your real credentials before deploying.
# connectionLimit is a count; acquireTimeout is milliseconds.
DATABASE_URL=mysql://cls_app:CHANGE_ME@127.0.0.1:3306/cls_facility?connectionLimit=5&acquireTimeout=30000

# ---------- Auth (better-auth) ----------
# Secret used to sign auth tokens. Generate a strong random value:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32

# Base URL of your app (dev: http://localhost:3000, prod: your real domain)
BETTER_AUTH_URL=http://localhost:3000

# Private runtime files. Must be outside public/ and on persistent storage in production.
PRIVATE_STORAGE_ROOT=.data
