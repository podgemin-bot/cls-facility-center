[Unit]
Description=Backup CLS Facility Center (database + private images)
After=mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/cls-facility/backup.env
ExecStart=/opt/cls-facility/bin/backup.sh
UMask=0077

ProtectSystem=strict
ReadWritePaths=/var/backups/cls /srv/cls-data
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
